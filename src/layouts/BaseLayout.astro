---
interface Props {
  title: string;
  description?: string;
  /** Page-relative path, e.g. "/about/". Used for canonical URL + og:url.
      Defaults to the current page's pathname when omitted. */
  path?: string;
  /** Per-page Schema.org JSON-LD object(s). Rendered after the site-wide
      Organization/WebSite blocks. Pass a single object or an array.
      Used by per-district pages to inject a Dataset-per-district. */
  extraJsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Absolute or site-relative URL of the OG card for this page. Falls back
      to the site-wide /og-image.png when omitted. Per-district pages pass
      /og/district/<state>/<district>.png. */
  ogImage?: string;
  /** Suppress indexing and the canonical link for error pages. */
  noindex?: boolean;
}

const defaultDescription = 'Project FINER is a public research preview of district-level financial-inclusion data assembled from SLBC and other source datasets. Coverage, periods and comparability vary by indicator and state.';
const { title, description = defaultDescription, path, extraJsonLd, ogImage, noindex = false } = Astro.props;
const extraJsonLdArray = Array.isArray(extraJsonLd) ? extraJsonLd : (extraJsonLd ? [extraJsonLd] : []);

const SITE_FOR_OG = 'https://projectfiner.com';
const resolvedOgImage = ogImage
  ? (ogImage.startsWith('http') ? ogImage : SITE_FOR_OG + (ogImage.startsWith('/') ? ogImage : '/' + ogImage))
  : `${SITE_FOR_OG}/og-image.png?v=2`;
const base = import.meta.env.BASE_URL;
const SITE = 'https://projectfiner.com';
const pagePath = path ?? Astro.url.pathname;
const canonicalUrl = SITE + (pagePath.endsWith('/') ? pagePath : pagePath + '/');

// Site-wide identity metadata. Dataset metadata belongs on the pages that can
// describe their actual coverage and provenance without implying blanket rights.
const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Project FINER',
  url: SITE,
  logo: `${SITE}/favicon.svg`,
  description: 'Putting India\'s financial inclusion data on the map, district by district, indicator by indicator.',
  email: 'mail@projectfiner.com',
  sameAs: ['https://github.com/ksabhinav/projectfiner'],
};
const webSiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Project FINER',
  url: SITE,
  description: defaultDescription,
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://unpkg.com; connect-src 'self' https://projectfiner-api.vercel.app https://ksabhinav.github.io; object-src 'none'; base-uri 'self'; form-action 'self'; frame-src 'none'; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests" />
  <meta name="referrer" content="strict-origin-when-cross-origin" />
  <meta name="description" content={description} />
  <title>{title}</title>
  {!noindex && <link rel="canonical" href={canonicalUrl} />}
  {noindex && <meta name="robots" content="noindex, nofollow" />}

  <!-- Atlas favicons —  bump version to force re-fetch when redesigned -->
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg?v=2`} />
  <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32.png?v=2`} />
  <link rel="icon" type="image/png" sizes="16x16" href={`${base}favicon-16.png?v=2`} />
  <link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png?v=2`} />
  <link rel="apple-touch-icon" sizes="180x180" media="(prefers-color-scheme: dark)" href={`${base}apple-touch-icon-dark.png?v=2`} />
  <link rel="mask-icon" href={`${base}favicon.svg?v=2`} color="#B84A2E" />
  <meta name="theme-color" content="#F4EFE6" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#1B140E" media="(prefers-color-scheme: dark)" />

  <!-- Open Graph / WhatsApp / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={resolvedOgImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:site_name" content="Project FINER" />
  <meta property="og:locale" content="en_IN" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={resolvedOgImage} />

  <!-- JSON-LD structured data — Organization + WebSite -->
  <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(webSiteLd)} />
  {extraJsonLdArray.map((ld) => (
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  ))}

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..700&family=Source+Serif+4:ital,opsz,wght@0,8..60,300..600;1,8..60,300..500&family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body>
  <slot />
</body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
