---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import DownloadManager from '../../components/DownloadManager.svelte';
import { readFileSync } from 'node:fs';
const base = import.meta.env.BASE_URL;

const releaseManifest = JSON.parse(readFileSync(
  new URL('../../../public/release-manifest.json', import.meta.url), 'utf8',
));
const stateMeta = (state: any) => {
  const coverage = state.coverage;
  return `${coverage.periodCount} periods · ${coverage.districtCount} source labels · ${coverage.categoryCount} categories`;
};
const neStates = releaseManifest.states.filter((state: any) => state.group === 'north-east');
const otherStates = releaseManifest.states.filter((state: any) => state.group === 'other');
const utStates = releaseManifest.states.filter((state: any) => state.group === 'ut');
---

<BaseLayout title="Downloads | Project FINER" description="Source-derived financial-inclusion datasets published as a research preview. Coverage, comparability and reuse rights vary by source.">
  <Header activeNav="downloads" />

  <div class="dl-page">
    <h1 class="dl-title">Datasets, in <span class="em">several formats</span>.</h1>
    <p class="dl-dek">
      Source-derived datasets downloadable as CSV and XLSX, with explicit coverage and rights status.
      <span class="cite">Cite as:</span> <em>"FINER (projectfiner.com), via [original source]."</em>
    </p>

    <aside class="release-notice">
      <div><span>Raw / experimental</span> Release {releaseManifest.releaseId}</div>
      <p>These files are a public research preview, not certified analysis-ready data. Coverage and schemas vary by state; source-label counts can include historical or unresolved geography labels.</p>
      <p>No blanket data licence is asserted. <a href={`${base}data-rights/`}>Review source rights</a> · <a href={`${base}release-manifest.json`}>Machine-readable manifest</a></p>
    </aside>

    <div class="dl-section-eye">SLBC booklets · North-East · 8 states</div>
    <div class="dl-grid">
      {neStates.map(state => (
        <a class="dl-card" href={`${base}slbc-data/${state.slug}/download`}>
          <div class="dl-card-eye">SLBC {state.name}</div>
          <div class="dl-card-name">{state.name}<span class="meta-suffix"> · all quarters</span></div>
          <div class="dl-card-meta">{stateMeta(state)}<br>Raw / experimental · rights not reviewed</div>
          <div class="dl-card-actions">
            <span class="dl-btn primary">Browse →</span>
          </div>
        </a>
      ))}
    </div>

    <div class="dl-section-eye">SLBC booklets · Other states · {otherStates.length} states</div>
    <div class="dl-grid">
      {otherStates.map(state => (
        <a class="dl-card" href={`${base}slbc-data/${state.slug}/download`}>
          <div class="dl-card-eye">SLBC {state.name}</div>
          <div class="dl-card-name">{state.name}<span class="meta-suffix"> · all quarters</span></div>
          <div class="dl-card-meta">{stateMeta(state)}<br>Raw / experimental · rights not reviewed</div>
          <div class="dl-card-actions">
            <span class="dl-btn primary">Browse →</span>
          </div>
        </a>
      ))}
    </div>

    <div class="dl-section-eye">UTLBC / NCT · {utStates.length} UTs &amp; Goa</div>
    <div class="dl-grid">
      {utStates.map(state => (
        <a class="dl-card" href={`${base}slbc-data/${state.slug}/download`}>
          <div class="dl-card-eye">{state.slug === 'goa' ? 'SLBC' : state.slug === 'delhi' ? 'SLBC' : 'UTLBC'} {state.name}</div>
          <div class="dl-card-name">{state.name}<span class="meta-suffix"> · all quarters</span></div>
          <div class="dl-card-meta">{stateMeta(state)}<br>Raw / experimental · rights not reviewed</div>
          <div class="dl-card-actions">
            <span class="dl-btn primary">Browse →</span>
          </div>
        </a>
      ))}
    </div>

    <div class="dl-section-eye">Meeting minutes · 6 NE states</div>
    <a class="dl-card minutes" href={`${base}slbc-data/meeting-minutes`}>
      <div class="dl-card-eye">SLBC meetings</div>
      <div class="dl-card-name">Minutes of the Meeting</div>
      <div class="dl-card-meta">141 SLBC meeting minutes summarised · Links to source PDFs</div>
      <div class="dl-card-actions">
        <span class="dl-btn primary">Browse →</span>
      </div>
    </a>

    <div class="dl-section-eye">Capital markets · raw provider registries · not district-mapped</div>
    <DownloadManager datasets={releaseManifest.capitalMarkets} sources={releaseManifest.sources} client:load />
  </div>
</BaseLayout>

<style>
  .dl-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 36px 32px 60px;
  }

  /* Atlas page title */
  .dl-title {
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 380;
    font-variation-settings: 'opsz' 144, 'SOFT' 30;
    font-size: 44px;
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: var(--ink, #1B140E);
    margin: 0 0 10px;
  }
  .dl-title .em {
    color: var(--vermillion-d, #8E331E);
    font-style: italic;
    font-weight: 320;
  }

  /* Italic Source Serif dek with cite-as line */
  .dl-dek {
    font-family: 'Source Serif 4', Georgia, serif;
    font-style: italic;
    font-size: 16px;
    color: var(--ink-soft, #3D332A);
    line-height: 1.55;
    margin: 0 0 32px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--rule, #D9D2C5);
    max-width: 740px;
  }
  .dl-dek .cite {
    font-style: normal;
    font-family: 'Inter', sans-serif;
    font-size: 9.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--vermillion, #B84A2E);
    margin-right: 4px;
  }
  .dl-dek em {
    font-style: italic;
    color: var(--ink, #1B140E);
  }

  .release-notice {
    margin: 0 0 32px;
    padding: 16px 18px;
    border: 1px solid var(--rule, #D9D2C5);
    border-left: 3px solid var(--gold, #8B6914);
    background: var(--paper-deep, #ECE5D6);
    color: var(--ink-soft, #3D332A);
    font-family: 'Source Serif 4', Georgia, serif;
    font-size: 14px;
    line-height: 1.5;
  }
  .release-notice div {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink, #1B140E);
  }
  .release-notice span {
    display: inline-block;
    margin-right: 8px;
    padding: 2px 6px;
    border-radius: 2px;
    background: var(--gold, #8B6914);
    color: white;
    font-weight: 700;
  }
  .release-notice p { margin: 8px 0 0; }
  .release-notice a { color: var(--vermillion-d, #8E331E); }

  /* Atlas section eyebrow with trailing rule */
  .dl-section-eye {
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--vermillion, #B84A2E);
    margin: 0 0 16px;
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .dl-section-eye::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--rule, #D9D2C5);
  }
  .dl-section-eye:not(:first-child) { margin-top: 36px; }

  /* Card grid */
  .dl-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin-bottom: 4px;
  }

  /* Atlas data card — paper bg, 1px rule, 3px vermillion left rule */
  .dl-card {
    display: flex;
    flex-direction: column;
    background: var(--paper, #F4EFE6);
    border: 1px solid var(--rule, #D9D2C5);
    border-left: 3px solid var(--vermillion, #B84A2E);
    border-radius: 4px;
    padding: 16px 16px 14px;
    text-decoration: none;
    color: inherit;
    transition: transform 160ms ease, box-shadow 160ms ease, border-left-color 160ms ease;
  }
  .dl-card:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(27, 20, 14, 0.06);
    border-left-color: var(--vermillion-d, #8E331E);
  }
  .dl-card.minutes {
    border-left-color: var(--peacock, #1E4960);
    margin-bottom: 4px;
  }
  .dl-card.minutes:hover { border-left-color: var(--peacock-d, #0E2F44); }

  .dl-card-eye {
    font-family: 'Inter', sans-serif;
    font-size: 8.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--mist, #6E665E);
    margin-bottom: 5px;
  }
  .dl-card-name {
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 400;
    font-variation-settings: 'opsz' 60;
    font-size: 18px;
    letter-spacing: -0.015em;
    line-height: 1.2;
    color: var(--ink, #1B140E);
    margin-bottom: 8px;
  }
  .dl-card-name .meta-suffix {
    color: var(--mist, #6E665E);
    font-style: italic;
    font-weight: 400;
    font-size: 14px;
  }
  .dl-card-meta {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 9.5px;
    color: var(--mist, #6E665E);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 14px;
    line-height: 1.6;
  }
  .dl-card-actions {
    margin-top: auto;
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .dl-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: 'Inter', sans-serif;
    font-size: 9px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 6px 10px;
    border-radius: 4px;
    border: 1px solid var(--ink, #1B140E);
    background: var(--paper, #F4EFE6);
    color: var(--ink, #1B140E);
  }
  .dl-btn.primary {
    background: var(--ink, #1B140E);
    color: var(--paper, #F4EFE6);
  }

  @media (max-width: 760px) {
    .dl-page { padding: 28px 18px 48px; }
    .dl-title { font-size: 32px; }
    .dl-dek { font-size: 14.5px; }
    .dl-grid { grid-template-columns: 1fr; gap: 10px; }
  }
</style>
