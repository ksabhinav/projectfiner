---
import PageLayout from '../../../layouts/PageLayout.astro';
import StateDownload from '../../../components/StateDownload.svelte';
import { readFileSync } from 'node:fs';

const base = import.meta.env.BASE_URL;
const releaseManifest = JSON.parse(readFileSync(
  new URL('../../../public/release-manifest.json', import.meta.url), 'utf8',
));
const stateRelease = releaseManifest.states.find((state: any) => state.slug === 'meghalaya');
const preview = stateRelease.distributions.find((item: any) => item.role === 'observations');
const periodLabel = (period: string) => {
  const [year, month] = period.split('-');
  const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun',
    'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  return `${months[Number(month) - 1]} ${year}`;
};
---

<PageLayout
  title="Meghalaya SLBC Data Download | Project FINER"
  description="Download district-level financial inclusion data for Meghalaya — quarterly SLBC booklets covering CD ratio, PMJDY, KCC, SHG, MUDRA, social security, digital coverage and more. CSV and the original PDF booklets. Public research preview; source rights vary."
  pageTitle="Meghalaya — SLBC Financial Inclusion Data"
  subtitle={`District-level indicators from SLBC NE quarterly booklets. All amounts in Rs. Lakhs.<br><a href="${base}slbc-data">&larr; All states</a> &nbsp;&middot;&nbsp; Source: <a href="https://slbcne.nic.in/meghalaya/booklet.php" target="_blank">slbcne.nic.in</a>`}
>
  <div class="stat-bar">
    <div class="stat-row">
      <div class="stat-item"><div class="stat-num">{stateRelease.coverage.periodCount}</div><div class="stat-lbl">Source periods</div></div>
      <div class="stat-item"><div class="stat-num">{stateRelease.coverage.districtCount}</div><div class="stat-lbl">LGD districts</div></div>
      <div class="stat-item"><div class="stat-num">{preview.indicatorCount}</div><div class="stat-lbl">Preview indicators</div></div>
      <div class="stat-item"><div class="stat-num">{preview.rowCount.toLocaleString('en-IN')}</div><div class="stat-lbl">Preview rows</div></div>
      <div class="stat-item"><div class="stat-num">{periodLabel(stateRelease.coverage.earliestPeriod)}</div><div class="stat-lbl">From</div></div>
      <div class="stat-item"><div class="stat-num">{periodLabel(stateRelease.coverage.latestPeriod)}</div><div class="stat-lbl">To</div></div>
    </div>
  </div>

  <div class="container">
    <StateDownload client:load stateName="Meghalaya" stateSlug="meghalaya" />
  </div>
</PageLayout>

<style>
  .container { max-width: 960px; margin: 0 auto; padding: 32px 40px 60px; }
</style>
